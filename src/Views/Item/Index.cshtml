@model IEnumerable<todo.Models.Item>

@{
    ViewBag.Title = "Full List of Volunteers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Upload Attendance:</h2>

@using (Html.BeginForm("Upload", "Item", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <input type="file" name="file" />
    <input type="submit" value="Upload" />
}

<h2>Full List of Volunteers</h2>

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Pronouns)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Team)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FinancialContribution)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EventCredits)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Attendance)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Pronouns)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Team)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Email)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FinancialContribution)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EventCredits)
        </td>
        <td>
            @Html.ActionLink("Attendance", "Attendance", new {item.Name, item.Attendance.Present, item.Attendance.Absent, item.Attendance.Late, item.Attendance.Unexcused})
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.Id })
        </td>
    </tr>
}
    
</table>
